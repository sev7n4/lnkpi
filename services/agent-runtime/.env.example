# Nest API base (must include /api prefix for internal canvas tools)
LNKPI_NEST_BASE_URL=http://127.0.0.1:3000/api
# Must match Nest AGENT_RUNTIME_SERVICE_TOKEN
LNKPI_NEST_SERVICE_TOKEN=dev-token
# Nest → Runtime auth for POST /v1/runs (optional; defaults to LNKPI_NEST_SERVICE_TOKEN)
# LNKPI_RUNTIME_AUTH_TOKEN=dev-token

LNKPI_SKILLS_DIR=skills
LNKPI_OPENAI_API_KEY=
LNKPI_OPENAI_BASE_URL=https://api.openai.com/v1
LNKPI_IMAGE_GEN_CONCURRENCY=3
LNKPI_IMAGE_GEN_TIMEOUT_SEC=180
# Product visual scheme v2 (prose SSOT + macro/shot decomposition)
# LNKPI_PRODUCT_VISUAL_SCHEME_V2=true
# W21 harness timeouts
LNKPI_CANVAS_TOOL_TIMEOUT_SEC=10
LNKPI_THREAD_LOCK_TIMEOUT_SEC=5
LNKPI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LNKPI_CIRCUIT_BREAKER_COOLDOWN_SEC=60
# W23 OTLP tracing (optional; empty = disabled)
# LNKPI_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# LNKPI_LANGSMITH_OTEL_ENABLED=true
# LNKPI_LANGSMITH_PROJECT=lnkpi-agent
# Dev only — also sends to LangSmith Cloud:
# LNKPI_LANGSMITH_API_KEY=lsv2_...
